#!/usr/bin/env bash

set -euo pipefail

digest="sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
fake_mode="${N2API_FAKE_DOCKER_MODE:-}"

ignore_term_forever() {
  trap '' TERM
  while :; do sleep 0.1; done
}

case "${1:-}" in
  info)
    exit 0
    ;;
  system)
    [[ "${2:-}" == "df" ]] && exit 0
    ;;
  buildx)
    exit 1
    ;;
  manifest)
    if [[ "${2:-}" == "inspect" && "${3:-}" == "--help" ]]; then
      exit 0
    fi
    if [[ "${2:-}" == "inspect" ]]; then
      jq -cn --arg digest "${digest}" '{
        schemaVersion:2,
        mediaType:"application/vnd.oci.image.index.v1+json",
        manifests:[
          {digest:$digest,platform:{os:"linux",architecture:"amd64"}},
          {digest:$digest,platform:{os:"linux",architecture:"arm64"}}
        ]
      }'
      exit 0
    fi
    ;;
  pull)
    if [[ "${fake_mode}" == "image_pull_ignore_term" ]]; then
      ignore_term_forever
    elif [[ "${fake_mode}" == "image_pull_wait" ]]; then
      while :; do sleep 0.1; done
    fi
    exit 0
    ;;
  run)
    if [[ " $* " == *" --entrypoint pg_restore "* && " $* " == *" --list "* ]]; then
      exit 0
    fi
    ;;
  image)
    if [[ "${2:-}" == "ls" ]]; then
      exit 0
    fi
    if [[ "${2:-}" == "inspect" && "${3:-}" == "--format" && "${4:-}" == *RepoDigests* ]]; then
      printf '["ghcr.io/knowsky404/n2api@%s"]\n' "${digest}"
      exit 0
    fi
    if [[ "${2:-}" == "inspect" && "${3:-}" == "--format" && "${4:-}" == *'.Id'* ]]; then
      printf 'sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n'
      exit 0
    fi
    if [[ "${2:-}" == "inspect" ]]; then
      exit 0
    fi
    ;;
  ps)
    exit 0
    ;;
  container|network|volume)
    if [[ "${2:-}" == "ls" || "${2:-}" == "rm" ]]; then
      exit 0
    fi
    if [[ "${1:-}" == "container" && "${2:-}" == "inspect" ]]; then
      exit 1
    fi
    if [[ "${1:-}" == "volume" && "${2:-}" == "inspect" ]]; then
      exit 1
    fi
    ;;
  compose)
    if [[ " $* " == *" version --short "* ]]; then
      printf '2.40.3\n'
      exit 0
    fi
    if [[ " $* " == *" config --quiet "* ]]; then
      exit 0
    fi
    if [[ " $* " == *" config --images "* ]]; then
      printf 'ghcr.io/knowsky404/n2api:2026073001@%s\n' "${digest}"
      printf 'postgres:18.4-alpine3.23@sha256:%s\n' "$(printf 'c%.0s' {1..64})"
      exit 0
    fi
    if [[ " $* " == *" ps --status running --quiet "* ]]; then
      exit 0
    fi
    if [[ " $* " == *" ps --quiet postgres "* ]]; then
      [[ "${fake_mode}" != "no_postgres" ]] || exit 0
      printf 'fake-postgres\n'
      exit 0
    fi
    if [[ " $* " == *" ps --all --format json "* ]]; then
      jq -cn '{ID:"fake-n2api",Name:"deploy-n2api-1",Project:"deploy",Service:"n2api",State:"running",Health:"healthy",ExitCode:0,Publishers:[{URL:"127.0.0.1",TargetPort:3000,PublishedPort:3000,Protocol:"tcp"}]}'
      jq -cn '{ID:"fake-postgres",Name:"deploy-postgres-1",Project:"deploy",Service:"postgres",State:"running",Health:"healthy",ExitCode:0,Publishers:[]}'
      exit 0
    fi
    if [[ " $* " == *" exec --no-TTY postgres pg_dump "* ]]; then
      if [[ "${fake_mode}" == "pg_dump_ignore_term" ]]; then
        [[ -z "${N2API_FAKE_DOCKER_READY_FILE:-}" ]] || : >"${N2API_FAKE_DOCKER_READY_FILE}"
        ignore_term_forever
      elif [[ "${fake_mode}" == "pg_dump_wait" ]]; then
        [[ -z "${N2API_FAKE_DOCKER_READY_FILE:-}" ]] || : >"${N2API_FAKE_DOCKER_READY_FILE}"
        while [[ ! -e "${N2API_FAKE_DOCKER_RELEASE_FILE:?set N2API_FAKE_DOCKER_RELEASE_FILE}" ]]; do sleep 0.1; done
      fi
      printf 'PGDMP-fake-custom-archive\n'
      [[ "${fake_mode}" != "pg_dump_fail" ]] || exit 1
      exit 0
    fi
    if [[ " $* " == *" exec --no-TTY postgres pg_restore --list "* ]]; then
      if [[ "${fake_mode}" == "archive_list_ignore_term" ]]; then
        ignore_term_forever
      elif [[ "${fake_mode}" == "archive_list_wait" ]]; then
        while :; do sleep 0.1; done
      fi
      [[ "${fake_mode}" != "archive_list_fail" ]] || exit 1
      exit 0
    fi
    if [[ "${fake_mode}" == "restore_wait" && " $* " == *" up --detach --wait postgres "* ]]; then
      [[ -z "${N2API_FAKE_DOCKER_RESTORE_READY_FILE:-}" ]] || : >"${N2API_FAKE_DOCKER_RESTORE_READY_FILE}"
      while :; do sleep 0.1; done
    fi
    if [[ "${fake_mode}" == "restore_pause" && " $* " == *" up --detach --wait postgres "* ]]; then
      [[ -z "${N2API_FAKE_DOCKER_RESTORE_READY_FILE:-}" ]] || : >"${N2API_FAKE_DOCKER_RESTORE_READY_FILE}"
      while [[ ! -e "${N2API_FAKE_DOCKER_RESTORE_RELEASE_FILE:?set N2API_FAKE_DOCKER_RESTORE_RELEASE_FILE}" ]]; do sleep 0.1; done
      exit 0
    fi
    if [[ "${fake_mode}" == "restore_cleanup_fail" && " $* " == *" down --volumes --remove-orphans --rmi local "* ]]; then
      exit 1
    fi
    if [[ " $* " == *" up --detach --wait postgres "* ||
      " $* " == *" up --detach --build --wait mock-openai n2api "* ||
      " $* " == *" build gateway-restore "* ||
      " $* " == *" down --volumes --remove-orphans --rmi local "* ]]; then
      exit 0
    fi
    if [[ " $* " == *" exec --no-TTY postgres pg_restore "* ]]; then
      exit 0
    fi
    if [[ " $* " == *" exec --no-TTY postgres psql "* ]]; then
      case "$*" in
        *'COALESCE(max(version_id)'*) printf '50\n' ;;
        *'FROM admins'*) printf '1\n' ;;
        *'FROM provider_accounts'*) printf '1\n' ;;
        *'FROM client_api_keys WHERE'*) printf '\n' ;;
        *'FROM client_api_keys'*) printf '0\n' ;;
        *'FROM request_logs'*) printf '0\n' ;;
        *'provider_account_credentials'*) printf '0\n' ;;
        *) printf '0\n' ;;
      esac
      exit 0
    fi
    if [[ " $* " == *" run --rm gateway-restore "* ]]; then
      [[ "${fake_mode}" != "restore_gateway_fail" ]] || exit 1
      exit 0
    fi
    if [[ " $* " == *" run --rm --no-deps --pull never -T n2api admin validate-config "* ]]; then
      jq -cn '{
        schema_version:"n2api.config-validation/v1",
        status:"valid",
        reason_code:"configuration_valid",
        postgres_password_check:"matched"
      }'
      exit 0
    fi
    if [[ " $* " == *" logs --since "* ]]; then
      printf 'n2api | status=ok password=do-not-retain\n'
      exit 0
    fi
    ;;
  inspect)
    if [[ " $* " == *'{{.State.Running}}|{{.Config.Image}}|{{.Image}}'* ]]; then
      printf 'true|ghcr.io/knowsky404/n2api:2026073001@%s|sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n' "${digest}"
      exit 0
    fi
    if [[ " $* " == *'{{.Name}}|{{.State.Running}}'* ]]; then
      printf '/deploy-n2api-1|true|healthy|ghcr.io/knowsky404/n2api:2026073001@%s|sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb|true|["ALL"]|["no-new-privileges:true"]|{"/tmp":"rw,noexec,nosuid,nodev,size=16m"}\n' "${digest}"
      exit 0
    fi
    ;;
  exec)
    if [[ " $* " == *'/livez'* ]]; then
      jq -cn '{status:"ok"}'
      exit 0
    fi
    if [[ " $* " == *'/readyz'* ]]; then
      jq -cn '{status:"ok",components:{database:"ready",runtime:"ready"}}'
      exit 0
    fi
    if [[ " $* " == *'/version'* ]]; then
      jq -cn '{version:"2026073001"}'
      exit 0
    fi
    ;;
esac

printf 'unexpected fake docker invocation: %s\n' "$*" >&2
exit 99
