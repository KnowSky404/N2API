{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://n2api.local/schemas/ops-backup-v1.json",
  "title": "N2API operator backup metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "backup_id",
    "created_at",
    "archive",
    "size_bytes",
    "checksum",
    "source_image",
    "source_schema_version",
    "evidence_class",
    "verified",
    "off_host_status",
    "integrity_hmac"
  ],
  "properties": {
    "schema_version": { "const": "n2api.ops.backup/v1" },
    "operation_id": { "type": "string", "pattern": "^op-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$" },
    "backup_id": { "type": "string", "pattern": "^backup-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "archive": { "type": "string", "pattern": "^n2api-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}\\.dump$" },
    "size_bytes": { "type": "integer", "minimum": 1 },
    "checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_image": { "type": "string", "pattern": "^ghcr\\.io/knowsky404/n2api:20[0-9]{8}@sha256:[0-9a-f]{64}$" },
    "source_schema_version": { "type": "integer", "minimum": 1 },
    "evidence_class": { "enum": ["ci_fixture", "real_operator"] },
    "verified": { "const": true },
    "off_host_status": { "const": "attention_missing" },
    "integrity_hmac": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
