{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://n2api.local/schemas/ops-receipt-v1.json",
  "title": "N2API operator receipt",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "required": ["integrity_hmac"],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^op-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"
        },
        "integrity_hmac": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  ]
}
