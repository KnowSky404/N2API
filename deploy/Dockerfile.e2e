FROM golang:1.26.10-alpine3.23@sha256:78e7f1e419545bc4b8b5ee8a40a99ddb5df1216d38681dbab2eeb1fdb2427f43 AS e2e-go-base
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./

FROM e2e-go-base AS mock-openai-builder
RUN CGO_ENABLED=0 go build -trimpath -o /out/mock-openai ./cmd/mock-openai

FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS mock-openai
RUN apk add --no-cache --upgrade curl libcrypto3 libssl3
WORKDIR /app
COPY --from=mock-openai-builder /out/mock-openai /app/mock-openai
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/mock-openai"]

FROM e2e-go-base AS gateway-e2e-builder
RUN CGO_ENABLED=0 go test -c -o /out/gateway-e2e ./e2e

FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS gateway-e2e
RUN apk add --no-cache --upgrade libcrypto3 libssl3
WORKDIR /app
COPY --from=gateway-e2e-builder /out/gateway-e2e /app/gateway-e2e
USER 65532:65532
ENTRYPOINT ["/app/gateway-e2e", "-test.v", "-test.timeout=3m"]

FROM oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS contracts-javascript
WORKDIR /app
COPY tests/contracts/javascript/package.json tests/contracts/javascript/bun.lock ./
RUN bun install --frozen-lockfile --production
COPY tests/contracts/javascript/openai.test.ts ./
USER bun
ENTRYPOINT ["bun", "test", "openai.test.ts"]

FROM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv-bin

FROM python:3.12.13-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b AS contracts-python
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY --from=uv-bin /uv /uvx /bin/
COPY tests/contracts/python/pyproject.toml tests/contracts/python/uv.lock tests/contracts/python/.python-version ./
RUN uv sync --locked --no-dev --no-install-project
COPY tests/contracts/python/test_openai.py ./
USER 65532:65532
ENTRYPOINT ["/app/.venv/bin/python", "-m", "unittest", "-v", "test_openai.py"]
