FROM golang:1.27.1-alpine3.23@sha256:d9e2f2f07b10cc922da3e80e035c3058810b328d5aef82d2c63680967c5e2ec9 AS e2e-go-base
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./

FROM e2e-go-base AS mock-openai-builder
RUN CGO_ENABLED=0 go build -trimpath -o /out/mock-openai ./cmd/mock-openai

FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS mock-openai
RUN apk add --no-cache --upgrade curl libcrypto3 libssl3
WORKDIR /app
COPY --from=mock-openai-builder /out/mock-openai /app/mock-openai
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/mock-openai"]

FROM e2e-go-base AS gateway-e2e-builder
RUN CGO_ENABLED=0 go test -c -o /out/gateway-e2e ./e2e

FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS gateway-e2e
RUN apk add --no-cache --upgrade libcrypto3 libssl3
WORKDIR /app
COPY --from=gateway-e2e-builder /out/gateway-e2e /app/gateway-e2e
USER 65532:65532
ENTRYPOINT ["/app/gateway-e2e", "-test.v", "-test.timeout=3m"]

FROM oven/bun:1.4.2-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f AS contracts-javascript
WORKDIR /app
COPY tests/contracts/javascript/package.json tests/contracts/javascript/bun.lock ./
RUN bun install --frozen-lockfile --production
COPY tests/contracts/javascript/openai.test.ts ./
USER bun
ENTRYPOINT ["bun", "test", "openai.test.ts"]

FROM ghcr.io/astral-sh/uv:0.12.13@sha256:b485bd65cc2cf1c9a93b3554012c9c3778cf7b1b5fd3d3096ce9e1226c97e1e6 AS uv-bin

FROM python:3.14.7-slim-bookworm@sha256:9ab8d9c8514b44f90cf0029dd42fdd7e9e211e639c8b995304cc04568dee900f AS contracts-python
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY --from=uv-bin /uv /uvx /bin/
COPY tests/contracts/python/pyproject.toml tests/contracts/python/uv.lock tests/contracts/python/.python-version ./
RUN uv sync --locked --no-dev --no-install-project
COPY tests/contracts/python/test_openai.py ./
USER 65532:65532
ENTRYPOINT ["/app/.venv/bin/python", "-m", "unittest", "-v", "test_openai.py"]
